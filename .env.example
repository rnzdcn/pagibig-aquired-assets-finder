# Required for the scheduled listing watch (api/cron/watch.js) — set these
# as Environment Variables in the Vercel project dashboard, not committed here.

# Which search to watch — mirrors the filters/search box in the UI.
WATCH_REGION=040000000
WATCH_PROVINCE=042100000
WATCH_CITY_MUNI=CITY OF DASMARIÑAS
WATCH_SEARCH=SAN MARINO

# Where to send the change notification.
NOTIFY_EMAIL=you@example.com

# Resend (https://resend.com) — free tier: 3,000 emails/month, 100/day.
RESEND_API_KEY=
# Sandbox sender works without domain verification, but only delivers to the
# email address on your Resend account. Verify a domain to send elsewhere.
RESEND_FROM_EMAIL=Pag-IBIG Watch <onboarding@resend.dev>

# Upstash Redis (https://upstash.com) — free tier: 500K commands/month.
# Create a database, then copy these from its REST API tab.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: set the same value in Vercel's Cron settings so this endpoint
# rejects requests that aren't from Vercel Cron.
CRON_SECRET=

# Daily 8am PHT push notification (works even with the app fully closed on
# desktop/Android — iOS Safari requires "Add to Home Screen" first).
# Generate a keypair with: npx web-push generate-vapid-keys
# Set the SAME public key twice — VITE_VAPID_PUBLIC_KEY is read by the client
# bundle, VAPID_PUBLIC_KEY (no prefix) is read by the cron function.
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
